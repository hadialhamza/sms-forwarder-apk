<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Master Gateway Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorInputBorder"
            app:cardBackgroundColor="@color/colorSurface">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/switch_master"
                    android:text="@string/status_active"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_master"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Unified SIM Routing Card with Inline Save Actions -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorInputBorder"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/label_sim_section"
                    style="@style/AppTheme.SectionHeader" />

                <!-- SIM 1 Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- SIM 1 Pill Badge -->
                    <LinearLayout
                        android:layout_width="68dp"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_badge_sim1">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_sim_card"
                            app:tint="@color/colorSim1Text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/label_sim1"
                            android:textColor="@color/colorSim1Text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SIM 1 Input (No placeholder, compact flat) -->
                    <EditText
                        android:id="@+id/input_sim1"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAutofill="no" />

                    <!-- SIM 1 Inline Save Button -->
                    <ImageButton
                        android:id="@+id/btn_save_sim1"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_save"
                        android:src="@drawable/ic_check_save"
                        app:tint="@color/colorSaveBtnIcon"
                        android:padding="10dp"
                        android:contentDescription="Save SIM 1" />
                </LinearLayout>

                <!-- Modern Subtle Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/colorDivider" />

                <!-- SIM 2 Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- SIM 2 Pill Badge -->
                    <LinearLayout
                        android:layout_width="68dp"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_badge_sim2">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_sim_card"
                            app:tint="@color/colorSim2Text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/label_sim2"
                            android:textColor="@color/colorSim2Text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SIM 2 Input (No placeholder, compact flat) -->
                    <EditText
                        android:id="@+id/input_sim2"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAutofill="no" />

                    <!-- SIM 2 Inline Save Button -->
                    <ImageButton
                        android:id="@+id/btn_save_sim2"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_save"
                        android:src="@drawable/ic_check_save"
                        app:tint="@color/colorSaveBtnIcon"
                        android:padding="10dp"
                        android:contentDescription="Save SIM 2" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
