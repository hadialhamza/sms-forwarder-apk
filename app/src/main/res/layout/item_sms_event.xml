<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Left: SIM Badge, Sender & Time -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/layout_status_actions"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_event_sim"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_badge_sim1"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="SIM 1"
                android:textColor="@color/colorSim1Text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_event_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="IVACBD"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="•"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_event_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="10:42 PM"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Right: Status Badge & Resend Button -->
        <LinearLayout
            android:id="@+id/layout_status_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_event_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● DELIVERED"
                android:textColor="@color/colorSuccess"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_event_resend"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:text="Resend"
                android:textSize="11sp"
                android:visibility="gone"
                app:icon="@drawable/ic_refresh"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorDanger"
                android:textColor="@color/colorDanger"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Full SMS Text Body -->
    <TextView
        android:id="@+id/text_event_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="Full SMS text goes here..."
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp" />

    <!-- Divider for list -->
    <View
        android:id="@+id/divider_event"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@color/colorDivider" />

</LinearLayout>
